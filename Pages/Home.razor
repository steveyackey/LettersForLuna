@page "/"
@inject IJSRuntime JS

<PageTitle>Letters for Luna</PageTitle>

<div class="letter-container" @onclick="OnLetterTap">
    <div class="letter-display">
        <span class="uppercase">@char.ToUpper(currentLetter)</span>
        <span class="lowercase">@char.ToLower(currentLetter)</span>
    </div>
</div>

<div class="mode-toggle" @onclick="ToggleMode" @onclick:stopPropagation="true">
    @(isAlphabetical ? "ABC" : "Random")
</div>

@code {
    private char currentLetter = 'A';
    private static readonly char[] letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray();
    private const int AdvanceDelayMilliseconds = 3000;
    private Random random = new Random();
    private bool isAlphabetical = false;
    private bool isTapInProgress = false;
    private int currentIndex = 0;

    protected override void OnInitialized()
    {
        SelectRandomLetter();
    }

    private async Task OnLetterTap()
    {
        if (isTapInProgress)
        {
            return;
        }

        isTapInProgress = true;

        try
        {
            // Speak the letter
            await SpeakLetter(currentLetter.ToString());

            // Wait before allowing the letter to advance
            await Task.Delay(AdvanceDelayMilliseconds);

            // Switch to the next letter
            SelectNextLetter();
        }
        finally
        {
            isTapInProgress = false;
        }
    }

    private void SelectNextLetter()
    {
        if (isAlphabetical)
        {
            currentIndex = (currentIndex + 1) % letters.Length;
            currentLetter = letters[currentIndex];
        }
        else
        {
            SelectRandomLetter();
        }
    }

    private void SelectRandomLetter()
    {
        char newLetter;
        do
        {
            newLetter = letters[random.Next(letters.Length)];
        } while (newLetter == currentLetter && letters.Length > 1);
        
        currentLetter = newLetter;
    }

    private void ToggleMode()
    {
        isAlphabetical = !isAlphabetical;
        if (isAlphabetical)
        {
            currentIndex = Array.IndexOf(letters, char.ToUpper(currentLetter));
        }
        else
        {
            SelectRandomLetter();
        }
    }

    private async Task SpeakLetter(string letter)
    {
        // Just speak the letter name, not "uppercase"
        await JS.InvokeVoidAsync("speakText", letter.ToUpper());
    }
}
